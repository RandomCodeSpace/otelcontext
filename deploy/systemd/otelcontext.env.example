# OtelContext systemd environment file.
# Install as /etc/otelcontext/otelcontext.env with root:otelcontext 0640.
# This is parsed by systemd, not a shell: do not add `export` or command substitutions.

APP_ENV=production
AGGREGATE_MODE=legacy
DB_AUTOMIGRATE=false

# Primary profile: PostgreSQL 16, one unpartitioned database, one process.
DB_DRIVER=postgres
DB_DSN=postgres://otelcontext:replace-me@127.0.0.1:5432/otelcontext?sslmode=require

# Bounded alternative: SQLite, one process, at most five services, low write rate.
# Comment the PostgreSQL lines above, then uncomment both lines below.
# DB_DRIVER=sqlite
# DB_DSN=/var/lib/otelcontext/otelcontext.db

HTTP_PORT=8080
GRPC_PORT=4317
DLQ_PATH=/var/lib/otelcontext/dlq
TLS_CACHE_DIR=/var/lib/otelcontext/tls
AGGREGATE_DB_PATH=/var/lib/otelcontext/aggregate.db
DATA_DISK_PATH=/var/lib/otelcontext
HOT_RETENTION_DAYS=7

# Choose the existing authentication and transport settings for your deployment.
# API_KEY=replace-with-a-long-random-value
# TLS_CERT_FILE=/etc/otelcontext/tls/server.crt
# TLS_KEY_FILE=/etc/otelcontext/tls/server.key
# AUTH_TRUST_EXTERNAL=true
