APP_ENV=production
HTTP_PORT=8080
GRPC_PORT=4317
DB_DRIVER=sqlite
DB_DSN=/var/lib/otelcontext/otelcontext.db
DB_AUTOMIGRATE=false
AGGREGATE_MODE=aggregate
AGGREGATE_DB_PATH=/var/lib/otelcontext/aggregate.db
AGGREGATE_ALLOW_REBUILD=false
# production-200 measures 9000 live log series and 20 templates per service.
# Keep the other signal caps; total = 12000 + 2400 + 2400 + 500 + 200.
AGGREGATE_MAX_SERIES=17500
AGGREGATE_MAX_SERIES_LOGS=12000
AGGREGATE_MAX_LOG_TEMPLATES_PER_SERVICE=32
AGGREGATE_MAX_OPERATION_NAMES_PER_TENANT=10000
AGGREGATE_MAX_OPERATION_NAMES=100000
AGGREGATE_MAX_METRIC_NAMES_PER_TENANT=5000
AGGREGATE_MAX_METRIC_NAMES=50000
AGGREGATE_MAX_LOG_TEMPLATES_PER_TENANT=5000
AGGREGATE_MAX_LOG_TEMPLATES=50000
DLQ_PATH=/var/lib/otelcontext/dlq
DATA_DISK_PATH=/var/lib/otelcontext
TLS_CACHE_DIR=/var/lib/otelcontext/tls
HOT_RETENTION_DAYS=7
EXEMPLAR_RETENTION_DAYS=7
# 2016 five-minute windows * 512 KiB = 1008 MiB payload before SQLite overhead.
EXEMPLAR_BYTES_GLOBAL_WINDOW=524288
EXEMPLAR_BYTES_PER_SERVICE_WINDOW=131072
# Measured seven-day sizing candidates; combined runtime acceptance is pending.
READY_AGGREGATE_DISK_BUDGET_MB=6144
DATA_DISK_BUDGET_MB=14336
DEFAULT_TENANT=default
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_REQUIRED=true
PROMETHEUS_TENANT_ID=default
MCP_ENABLED=true
MCP_PATH=/mcp
# Preserve heap/concurrency settings with the 3 CPU/6 GiB resource partition.
# GOMAXPROCS controls Go parallelism; the container CPU quota remains 3 CPU.
GOMEMLIMIT=3GiB
GOMAXPROCS=4
